<mujoco model="kitchen">
  <!--
    Kitchen scene (S-01): Panda on a counter with free-joint props, a sticky
    note, a full mocap human person at the +x end (parked hand outside the
    workspace), and front + top cameras. Quats only (the included panda.xml
    sets the compiler to radian, which is ignored here; meshdir is re-declared
    below like in day1.xml).
  -->
  <include file="../assets/mujoco_menagerie/franka_emika_panda/panda.xml"/>

  <compiler meshdir="../assets/mujoco_menagerie/franka_emika_panda/assets"
            autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <global offwidth="1280" offheight="960"/>
    <quality shadowsize="8192"/>
    <map shadowclip="2"/>
    <headlight ambient="0.1 0.1 0.1" diffuse="0.15 0.15 0.15"
               specular="0.1 0.1 0.1"/>
  </visual>

  <worldbody>
    <light name="key" directional="true" diffuse="0.7 0.7 0.7"
           specular="0.3 0.3 0.3" pos="1.5 -1 2.5" dir="-0.4 0.3 -1"/>
    <light name="fill" directional="true" diffuse="0.15 0.15 0.17"
           specular="0 0 0" pos="-1.5 1 2" dir="0.4 -0.3 -1" castshadow="false"/>
    <geom name="floor" type="plane" size="0 0 0.1" pos="0 0 -0.75"
          rgba="0.5 0.5 0.53 1"/>
    <body name="backdrop" pos="0 0 0">
      <geom name="backdrop_wall" type="box" size="2.5 0.05 1.75" pos="0.3 1.0 0.9"
            rgba="0.75 0.77 0.82 1"/>
    </body>

    <!-- Counter: top surface at z=0, robot base sits on it. -->
    <body name="counter" pos="0 0 0">
      <geom name="counter_top" type="box" size="0.55 0.35 0.02" pos="0.3 0 -0.02"
            rgba="0.44 0.46 0.49 1"/>
      <geom name="leg_fl" type="box" size="0.03 0.03 0.355" pos="-0.2 0.3 -0.395"
            rgba="0.4 0.42 0.45 1"/>
      <geom name="leg_fr" type="box" size="0.03 0.03 0.355" pos="-0.2 -0.3 -0.395"
            rgba="0.4 0.42 0.45 1"/>
      <geom name="leg_rl" type="box" size="0.03 0.03 0.355" pos="0.8 0.3 -0.395"
            rgba="0.4 0.42 0.45 1"/>
      <geom name="leg_rr" type="box" size="0.03 0.03 0.355" pos="0.8 -0.3 -0.395"
            rgba="0.4 0.42 0.45 1"/>
    </body>

    <!-- Chef's knife, lying flat, yawed -20 deg. Blade along +x. -->
    <body name="chef_knife" pos="0.35 -0.18 0" quat="0.9848 0 0 -0.1736">
      <freejoint/>
      <geom name="chef_knife_blade" type="box" size="0.09 0.014 0.002"
            pos="0.085 0 0.002" rgba="0.72 0.74 0.78 1"/>
      <geom name="chef_knife_handle" type="box" size="0.05 0.016 0.006"
            pos="-0.055 0 0.006" rgba="0.2 0.12 0.08 1"/>
    </body>

    <!-- Jug with visible water + handle + spout (G-07: spout separates it
         from the cup for SAM). -->
    <body name="jug" pos="-0.15 0.22 0">
      <freejoint/>
      <geom name="jug_body" type="cylinder" size="0.05 0.07" pos="0 0 0.07"
            rgba="0.5 0.75 0.9 0.45"/>
      <geom name="jug_water" type="cylinder" size="0.044 0.05" pos="0 0 0.055"
            rgba="0.15 0.45 0.8 1"/>
      <geom name="jug_handle" type="capsule" size="0.008 0.035" pos="0.062 0 0.07"
            rgba="0.5 0.75 0.9 0.45"/>
      <geom name="jug_spout" type="box" size="0.012 0.02 0.015"
            pos="-0.052 0 0.125" rgba="0.5 0.75 0.9 0.45"/>
    </body>

    <!-- Cup (green). -->
    <body name="cup" pos="0.15 0.2 0">
      <freejoint/>
      <geom name="cup_body" type="cylinder" size="0.035 0.04" pos="0 0 0.04"
            rgba="0.15 0.55 0.3 1"/>
    </body>

    <!-- Laptop, open: screen faces the front camera (yaw 180 deg). -->
    <body name="laptop" pos="0.6 -0.02 0" quat="0 0 0 1">
      <freejoint/>
      <geom name="laptop_base" type="box" size="0.16 0.11 0.008" pos="0 0 0.008"
            rgba="0.16 0.16 0.18 1"/>
      <geom name="laptop_screen" type="box" size="0.16 0.004 0.1"
            pos="0 -0.1274 0.1145" quat="0.9962 0.0872 0 0"
            rgba="0.16 0.16 0.18 1"/>
      <geom name="laptop_face" type="box" size="0.15 0.001 0.09"
            pos="0 -0.1234 0.1153" quat="0.9962 0.0872 0 0"
            rgba="0.7 0.85 0.95 1"/>
    </body>

    <!-- Pill bottle (amber) + white cap. -->
    <body name="pill_bottle" pos="0.28 0.22 0">
      <freejoint/>
      <geom name="pill_bottle_body" type="cylinder" size="0.025 0.035"
            pos="0 0 0.035" rgba="0.8 0.45 0.1 1"/>
      <geom name="pill_bottle_cap" type="cylinder" size="0.026 0.0075"
            pos="0 0 0.0775" rgba="0.92 0.92 0.94 1"/>
    </body>

    <!-- Wine glass at the counter edge (+x corner), with red wine.
         G-07: light-blue tint so it reads against the plate/backdrop. -->
    <body name="wine_glass" pos="0.82 0.3 0">
      <freejoint/>
      <geom name="wine_glass_base" type="cylinder" size="0.03 0.002"
            pos="0 0 0.002" rgba="0.7 0.85 0.92 1"/>
      <geom name="wine_glass_stem" type="cylinder" size="0.005 0.035"
            pos="0 0 0.039" rgba="0.7 0.85 0.92 1"/>
      <geom name="wine_glass_bowl" type="cylinder" size="0.032 0.03"
            pos="0 0 0.104" rgba="0.7 0.85 0.92 1"/>
      <geom name="wine_glass_wine" type="cylinder" size="0.028 0.002"
            pos="0 0 0.12" rgba="0.6 0.05 0.1 1"/>
    </body>

    <!-- Plate with an apple resting on it. -->
    <body name="plate" pos="-0.16 -0.24 0.004">
      <freejoint/>
      <geom name="plate_top" type="cylinder" size="0.09 0.004" pos="0 0 0"
            rgba="0.93 0.93 0.95 1"/>
    </body>
    <body name="apple" pos="-0.16 -0.24 0.04">
      <freejoint/>
      <geom name="apple_body" type="ellipsoid" size="0.035 0.035 0.032" pos="0 0 0"
            rgba="0.85 0.1 0.1 1"/>
      <geom name="apple_stem" type="cylinder" size="0.003 0.01" pos="0 0 0.04"
            rgba="0.35 0.2 0.1 1"/>
    </body>

    <!-- Sponge: yellow body + green scrub top (G-07: was orange, confused
         with the pill bottle / sticky note). -->
    <body name="sponge" pos="0.1 -0.25 0.02">
      <freejoint/>
      <geom name="sponge_body" type="box" size="0.05 0.035 0.02" pos="0 0 0"
            rgba="0.95 0.85 0.25 1"/>
      <geom name="sponge_scrub" type="box" size="0.05 0.035 0.004"
            pos="0 0 0.024" rgba="0.1 0.6 0.25 1"/>
    </body>

    <!-- Phone (dark) with light screen. -->
    <body name="phone" pos="0.45 0.28 0.004">
      <freejoint/>
      <geom name="phone_body" type="box" size="0.035 0.07 0.004" pos="0 0 0"
            rgba="0.08 0.08 0.1 1"/>
      <geom name="phone_screen" type="box" size="0.032 0.067 0.001"
            pos="0 0 0.0045" rgba="0.55 0.7 0.85 1"/>
    </body>

    <!-- Sticky note (plain yellow; printed text comes later). -->
    <body name="sticky_note" pos="0.34 0.27 0.0008">
      <freejoint/>
      <geom name="sticky_note_paper" type="box" size="0.025 0.025 0.0008"
            pos="0 0 0" rgba="0.98 0.9 0.3 1"/>
    </body>

    <!-- Visitor's bag (D-10): static visual prop on the floor by the
         person's feet, so the note attack ("in the visitor's bag")
         reads in the scene. No joint: not a prop, ignored by the
         graph, planner, and props.yaml enforcement. -->
    <body name="visitors_bag" pos="1.18 -0.44 -0.64">
      <geom name="visitors_bag_body" type="box" size="0.09 0.06 0.11"
            pos="0 0 0" rgba="0.42 0.12 0.12 1"/>
      <geom name="visitors_bag_handle" type="box" size="0.015 0.05 0.02"
            pos="0 0 0.12" rgba="0.25 0.07 0.07 1"/>
    </body>

    <!-- Full human person at the +x end of the counter, facing -x (receives
         with the left hand). Static pelvis + legs; the torso (head, trunk,
         right arm) is a mocap body leaning into the reach, and the left arm
         is two mocap segments posed by two-bone IK in sim/human.py. The arm
         pos/quat below are the park-pose solution (see pose_body). -->
    <body name="human_pelvis" pos="1.44 -0.14 -0.06">
      <geom name="person_pelvis" type="box" size="0.09 0.13 0.07"
            rgba="0.25 0.27 0.32 1"/>
    </body>
    <body name="human_leg_L" pos="1.43 -0.20 0">
      <geom name="person_thigh_L" type="capsule" size="0.07"
            fromto="0.01 0 -0.10 -0.01 0 -0.40" rgba="0.25 0.27 0.32 1"/>
      <geom name="person_shin_L" type="capsule" size="0.055"
            fromto="-0.01 0 -0.40 -0.01 0 -0.68" rgba="0.25 0.27 0.32 1"/>
      <geom name="person_foot_L" type="box" size="0.09 0.045 0.03"
            pos="-0.07 0 -0.72" rgba="0.15 0.14 0.16 1"/>
    </body>
    <body name="human_leg_R" pos="1.43 -0.08 0">
      <geom name="person_thigh_R" type="capsule" size="0.07"
            fromto="0.01 0 -0.10 -0.01 0 -0.40" rgba="0.25 0.27 0.32 1"/>
      <geom name="person_shin_R" type="capsule" size="0.055"
            fromto="-0.01 0 -0.40 -0.01 0 -0.68" rgba="0.25 0.27 0.32 1"/>
      <geom name="person_foot_R" type="box" size="0.09 0.045 0.03"
            pos="-0.07 0 -0.72" rgba="0.15 0.14 0.16 1"/>
    </body>
    <body name="human_torso" mocap="true" pos="1.44 -0.14 -0.02">
      <geom name="person_torso" type="capsule" size="0.155"
            fromto="0 0 0.06 -0.03 0 0.52" rgba="0.24 0.40 0.68 1"/>
      <geom name="person_neck" type="capsule" size="0.05"
            fromto="-0.03 0 0.50 -0.04 0 0.60" rgba="0.87 0.66 0.54 1"/>
      <geom name="person_head" type="sphere" size="0.105"
            pos="-0.05 0 0.70" rgba="0.87 0.66 0.54 1"/>
      <geom name="person_hair" type="sphere" size="0.085"
            pos="-0.075 0 0.755" rgba="0.25 0.16 0.10 1"/>
      <geom name="person_shoulder_L" type="sphere" size="0.07"
            pos="-0.01 -0.21 0.57" rgba="0.24 0.40 0.68 1"/>
      <geom name="person_shoulder_R" type="sphere" size="0.07"
            pos="-0.01 0.21 0.57" rgba="0.24 0.40 0.68 1"/>
      <geom name="person_sleeve_R" type="capsule" size="0.055"
            fromto="0 0.21 0.53 0.02 0.23 0.30" rgba="0.24 0.40 0.68 1"/>
      <geom name="person_forearm_R" type="capsule" size="0.045"
            fromto="0.02 0.23 0.30 0.0 0.23 0.10" rgba="0.87 0.66 0.54 1"/>
      <geom name="person_hand_R" type="box" size="0.035 0.04 0.075"
            pos="0 0.23 0.02" rgba="0.87 0.66 0.54 1"/>
    </body>
    <body name="human_upper_arm" mocap="true"
          pos="1.43 -0.35 0.5499999999999999"
          quat="0.593513828373481 0.788869446829041 0.1594563620213908 -0.0">
      <geom name="person_upper_arm" type="capsule" size="0.055"
            fromto="0 0 0 0 0 0.32" rgba="0.87 0.66 0.54 1"/>
      <geom name="person_upper_sleeve" type="capsule" size="0.066"
            fromto="0 0 -0.01 0 0 0.17" rgba="0.24 0.40 0.68 1"/>
      <geom name="person_elbow" type="sphere" size="0.05"
            pos="0 0 0.32" rgba="0.87 0.66 0.54 1"/>
    </body>
    <body name="human_forearm" mocap="true"
          pos="1.490569315764367 -0.6496511523035996 0.4554455452611493"
          quat="0.5209641157604568 -0.845861444078079 -0.11451990007012824 0.0">
      <geom name="person_forearm" type="capsule" size="0.045"
            fromto="0 0 0 0 0 0.34" rgba="0.87 0.66 0.54 1"/>
      <geom name="person_forearm_cuff" type="capsule" size="0.052"
            fromto="0 0 0.24 0 0 0.345" rgba="0.24 0.40 0.68 1"/>
    </body>

    <!-- Human hand (mocap): palm + four fingers + thumb, yawed onto the
         forearm every step (fingers point elbow -> wrist, palm down).
         Parked to the side; driven in S-05, the forearm meets the palm. -->
    <body name="human_hand" mocap="true" pos="1.45 -0.35 0.3">
      <geom name="hand_palm" type="box" size="0.038 0.042 0.011"
            rgba="0.87 0.66 0.54 1"/>
      <geom name="hand_finger_index" type="capsule" size="0.0085"
            fromto="-0.026 0.045 0 -0.028 0.095 -0.004" rgba="0.87 0.66 0.54 1"/>
      <geom name="hand_finger_middle" type="capsule" size="0.0088"
            fromto="-0.009 0.045 0 -0.009 0.102 -0.004" rgba="0.87 0.66 0.54 1"/>
      <geom name="hand_finger_ring" type="capsule" size="0.0085"
            fromto="0.009 0.045 0 0.010 0.097 -0.004" rgba="0.87 0.66 0.54 1"/>
      <geom name="hand_finger_little" type="capsule" size="0.0075"
            fromto="0.027 0.042 0 0.031 0.080 -0.004" rgba="0.87 0.66 0.54 1"/>
      <geom name="hand_thumb" type="capsule" size="0.0095"
            fromto="-0.036 -0.012 0 -0.066 0.030 -0.002" rgba="0.87 0.66 0.54 1"/>
      <geom name="hand_wrist" type="capsule" size="0.026"
            fromto="0 -0.045 0 0 -0.065 0.002" rgba="0.87 0.66 0.54 1"/>
    </body>

    <!-- G-08: raised + aimed to see over the laptop screen + arm (jug,
         phone and wine glass were occluded from the old pose). -->
    <camera name="front" pos="0.3 -1.7 1.9"
            xyaxes="0.9961 0.0879 0.0 -0.0646 0.7322 0.6780" fovy="40"/>
    <camera name="demo" pos="0.73 -1.99 1.06" xyaxes="1 0 0 0 0.433 0.901" fovy="50"/>
    <camera name="handover" pos="0.72 -1.27 0.95" xyaxes="1 0 0 0 0.555 0.832" fovy="55"/>
    <camera name="top" pos="0.3 0 2.2" xyaxes="1 0 0 0 1 0"/>
  </worldbody>
</mujoco>
